# Lenny Growth Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── Database ──────────────────────────────────────────────────────────────────
# Replace 'postgres' with your actual PostgreSQL username and password
# Replace 'lenny_assistant' with your database name if different
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/lenny_assistant

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# ── Active Provider ───────────────────────────────────────────────────────────
# Options: "ollama" | "anthropic" | "openai"
# Leave as "ollama" to use local model (no API key required)
ACTIVE_PROVIDER=ollama
ACTIVE_MODEL=llama3.2:3b

# ── Cloud Providers (optional) ────────────────────────────────────────────────
# Only needed if you want to use cloud models
# Leave blank or omit if using Ollama only
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloud model names (only used if ACTIVE_PROVIDER is set to that provider)
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENAI_MODEL=gpt-4o-mini

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── Retrieval ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
